                     </xs:annotation>
                  </xs:element>
                  <xs:element name="identifikationsnummerKind"
                              minOccurs="0"
                              type="xiid:PlausibilisierteIdentifikationsnummer">
                     <xs:annotation>
                        <xs:documentation>Hier kann zusätzlich zu den Namen des Kindes die Identifikationsnummer übermittelt werden, um den betroffenen Ehegatten zu identifizieren.rmgvorbehalt</xs:documentation>
                     </xs:annotation>
