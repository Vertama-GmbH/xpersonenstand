                        <xs:documentation>Hier ist der Text der Erklärung zu übermitteln.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzahlKinder" type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Hier ist die Anzahl der Kinder zu übermitteln, die unter 5 Jahre alt sind.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenKinder" minOccurs="0" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Hier können Daten zu Kindern unter 5 Jahren übermittelt werden.</xs:documentation>
                     </xs:annotation>
