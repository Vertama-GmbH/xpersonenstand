                                 <xs:documentation>Hier sind die Namen der erklärenden Person vor und nach der Erklärung mitzuteilen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsort" type="xpersonenstand:Ereignisort">
