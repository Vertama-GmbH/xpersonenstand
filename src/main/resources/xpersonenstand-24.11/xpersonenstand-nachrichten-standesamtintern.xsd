               <xs:sequence>
                  <xs:element name="angabenErklaerender">
                     <xs:annotation>
                        <xs:documentation>Hier sind Angaben zur erklärenden Person zu übermitteln.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="namen" type="xpersonenstand:PersonName.Aenderung">
