               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="stA2StA.Erklaerung.012230">
      <xs:annotation>
         <xs:appinfo>
            <autor>Standesamt (psw)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 46 (2) PStV</rechtsgrundlage>
            <title>Mitteilung über eine Erklärung zum Hinzufügen eines Begleitnamens oder dessen Widerruf zum Eheeintrag</title>
         </xs:appinfo>
         <xs:documentation>Diese Nachricht dient der Übermittlung der Erklärung über das Hinzufügen eines Begleitnamens oder den Widerruf des Hinzufügens an das Standesamt, das den Eheeintrag führt.</xs:documentation>
      </xs:annotation>
