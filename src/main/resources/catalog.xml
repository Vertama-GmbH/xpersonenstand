<?xml version="1.0" encoding="UTF-8"?>
<!--
  OASIS XML Catalog (v1.1) for XPersonenstand schema resolution.

  This file is Vertama-authored. It maps every external schema URL transitively
  imported by the bundled XSDs to its local vendored copy under schemas/.
  Used by:
    - xjc at build time (codegen)
    - SchemaFactory at runtime (validation)

  Layout convention:
    schemas/                — VENDORED, byte-identical mirror of upstream URLs.
                              Never hand-edit; re-fetch and diff to verify.
    catalog.xml             — OURS, hand-maintained, this file.
    binding.xjb             — OURS, JAXB codegen customization.

  Adding a new external XSD:
    1. Fetch it under schemas/<host>/<full-url-path>/<filename>.xsd
    2. Add a matching <uri> entry below.
    3. Run the build-time guard test (see xpersonenstand test suite) — it walks
       every xs:import in every bundled XSD and fails loudly if any URL is not
       mapped here.
-->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog" prefer="public">

