                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="artDerBescheinigung"
                              type="xpersonenstand:Urkundenanforderung.ArtDerBescheinigung.L">
                     <xs:annotation>
                        <xs:documentation>Hier werden Angaben zur Art und Anzahl der auszustellenden Bescheinigungen übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
