                        <xs:documentation>Falls eine Zuordnung (beispielweise eine Kontoreferenz oder eine UUID) in der Ausgangsnachricht übermittelt wurde, wird sie hier zurückgespiegelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
