   <xs:element name="portal2StA.Sterbefall.084010">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 28 PStG i. V. m. § 30 PStG</rechtsgrundlage>
            <title>Voranzeige eines Sterbefalls</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht können die Angaben zu einem Sterbefall im Rahmen einer elektronischen Voranzeige dem Standesamt übermittelt werden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2G">
               <xs:sequence>
                  <xs:element name="todestag">
                     <xs:annotation>
                        <xs:documentation>Hier sind Angaben zum Zeitpunkt des Todes zu übermitteln. Sofern der Todestag und die Todeszeit festgestellt werden konnten, sind die Angaben im Element todestag zu übermitteln. Sollte kein Todestag sondern nur ein Sterbezeitraum festgestellt worden sein, sind die Angaben im Element sterbezeitraum zu übermitteln.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="todestag">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="todestag" type="xida:Tagesdatum"/>
                                    <xs:element name="todeszeit"
                                                type="xpersonenstand:UhrzeitPersonenstandswesenMitExakt">
                                       <xs:annotation>
                                          <xs:documentation>Sofern zur Todeszeit nur ungefähre Angaben gemacht werden können, ist das Element exakt=false zu übermitteln. Handelt es sich um eine genaue Zeitangabe, ist exakt=true zu übermitteln.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="sterbezeitraum">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="letzterTagLebend" minOccurs="0" type="xida:Tagesdatum">
                                       <xs:annotation>
                                          <xs:documentation>Sollte kein Todestag sondern nur der Sterbezeitraum bekannt sein, ist hier der Tag mitzuteilen, an dem der Verstorbene zuletzt lebend gesehen wurde.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="letzterTagLebendUhrzeit"
                                                minOccurs="0"
                                                type="xpersonenstand:UhrzeitPersonenstandswesen">
                                       <xs:annotation>
                                          <xs:documentation>Sollte kein Todestag sondern nur der Sterbezeitraum bekannt sein, ist hier die Uhrzeit mitzuteilen, zu der der Verstorbene zuletzt lebend gesehen wurde.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="mitSicherheitTotTag" type="xida:Tagesdatum">
                                       <xs:annotation>
                                          <xs:documentation>Sollte kein Todestag sondern nur der Sterbezeitraum bekannt sein, ist hier der Tag mitzuteilen, an dem der Verstorbene mit Sicherheit tot war.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="mitSicherheitTotUhrzeit"
                                                type="xpersonenstand:UhrzeitPersonenstandswesen">
                                       <xs:annotation>
                                          <xs:documentation>Sollte kein Todestag sondern nur der Sterbezeitraum bekannt sein, ist hier die Uhrzeit mitzuteilen, zu der der Verstorbene mit Sicherheit tot war.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="sterbeort" type="xpersonenstand:Anz2StA.Ereignisort.Detail">
                     <xs:annotation>
                        <xs:documentation>Angaben zum Sterbeort</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="verstorbener">
                     <xs:annotation>
                        <xs:documentation>Angaben zum Verstorbenen</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Anz2StA.Person">
                              <xs:sequence>
                                 <xs:element name="familienstand"
                                             minOccurs="0"
                                             type="xpersonenstand:Code.FamilienstandPersonenstandswesen"/>
                                 <xs:element name="letzterWohnsitz"
                                             minOccurs="0"
                                             type="xpersonenstand:Portal2StA.Anschrift">
                                    <xs:annotation>
                                       <xs:documentation>Hier wird die letzte Anschrift des Verstorbenen übertragen, falls sie bekannt ist.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                                 <xs:element name="geburtseintragBehoerde"
                                             minOccurs="0"
                                             type="xpersonenstand:Behoerdenbezeichnung">
                                    <xs:annotation>
                                       <xs:documentation>Der Name der Behörde, in dem die Geburt beurkundet wurde.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                                 <xs:element name="geburtseintragNummer" minOccurs="0" type="din91379:datatypeC">
                                    <xs:annotation>
                                       <xs:documentation>Die laufende Eintragsnummer der Geburt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                                 <xs:element name="erstbeurkundungsjahrGeburt" minOccurs="0" type="xs:gYear">
                                    <xs:annotation>
                                       <xs:documentation>Das Jahr der Erstbeurkundung der Geburt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="partnerDesVerstorbenen" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>War der Verstorbene verheiratet oder führte eine Lebenspartnerschaft können hier Angaben zum hinterbliebenen Ehegatten bzw. Lebenspartner gemacht werden. War der Verstorbene verwitwet oder die Lebenspartnerschaft durch Tod aufgelöst, können hier die Angaben zum letzten Ehegatten bzw. Lebenspartner gemacht werden.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="vorname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier werden die Vornamen übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="familienname" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen der Vorname des Partners des Verstorbenen nicht identifiziert werden kann oder nicht existiert, wird der Name vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Der Geburtsname ist nur anzugeben, wenn er vom Familiennamen abweicht.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geschlecht" minOccurs="0" type="xig:Code.Geschlecht"/>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="auskunftsgeber" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Falls es einen Auskunftsgeber gibt und dieser nicht Partner oder Kind des Verstorbenen ist, werden dessen Angaben hier übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="vorname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Falls bekannt, werden hier die Vornamen des Auskunftsgebers übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="familienname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen eine Unterscheidung von Vor- und Familiennamen nicht möglich ist oder ein Vorname zurecht nicht existiert, wird der Name des Auskunftsgebers vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Sofern vorhanden, ist hier der Geburtsname mitzuteilen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="anschrift"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Anschrift"/>
                           <xs:element name="kontaktdaten"
                                       maxOccurs="unbounded"
                                       type="bn-uq-g2g:KommunikationType"/>
                           <xs:element name="verhaeltnisVerstorbener"
                                       minOccurs="0"
                                       type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Angaben über das verwandtschaftliche Verhältnis des Auskunftgebers zum Verstorbenen (z.B. Sohn, Ehefrau, etc.).</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="anzahlKinderVolljaehrig"
                              minOccurs="0"
                              type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Die Zahl der volljährigen Kinder des Verstorbenen</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzahlKinderMinderjaehrig"
                              minOccurs="0"
                              type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Die Zahl der minderjährigen Kinder des Verstorbenen</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="artDerBestattung"
                              minOccurs="0"
                              type="xpersonenstand:Code.Bestattungsart">
                     <xs:annotation>
                        <xs:documentation>Hier kann die Art der Bestattung übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zahlDerUrkunden" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Hier kann die gewünschte Zahl der Sterbeurkunden angegeben werden.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="zahlDerUrkundenStandard"
                                       minOccurs="0"
                                       type="xs:nonNegativeInteger">
                              <xs:annotation>
                                 <xs:documentation>Die gewünschte Zahl der Urkunden im Standardformat (DIN A4).</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="zahlDerUrkundenStammbuch"
                                       minOccurs="0"
                                       type="xs:nonNegativeInteger">
                              <xs:annotation>
                                 <xs:documentation>Die gewünschte Zahl der Urkunden im Stammbuchformat.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="zahlDerUrkundenCiec16"
                                       minOccurs="0"
                                       type="xs:nonNegativeInteger">
                              <xs:annotation>
                                 <xs:documentation>Die gewünschte Zahl der internationalen Urkunden nach dem CIEC Abkommen 16.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="zahlDerUrkundenCiec34"
                                       minOccurs="0"
                                       type="xs:nonNegativeInteger">
                              <xs:annotation>
                                 <xs:documentation>Die gewünschte Zahl der internationalen Urkunden nach dem CIEC Abkommen 34.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="eheVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Wenn der Verstorbene zum Zeitpunkt des Todes verheiratet, verwitwet oder geschieden war werden hier die Angaben zur Eheschließung gemacht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="lpVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Wenn der Verstorbene zum Zeitpunkt des Todes in eingetragener Lebenspartnerschaft lebte oder die Lebenspartnerschaft aufgelöst war, werden hier die Angaben zur Begründung der Lebenspartnerschaft gemacht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aufloesungEheVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Aufloesung.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier können Angaben zur Auflösung der Ehe des Verstorbenen übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aufloesungLpVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Aufloesung.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier können Angaben zur Auflösung der Lebenspartnerschaft des Verstorbenen übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzeigender" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Hier können die Angaben zum Anzeigenden übermittelt werden, um dem Standesamt eine Möglichkeit zur Rücksprache bei Fragen zu geben.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Portal2StA.Anzeigender">
                              <xs:sequence>
                                 <xs:element name="namen">
                                    <xs:annotation>
                                       <xs:documentation>Hier werden die Namen des Anzeigenden mitgeteilt.</xs:documentation>
                                    </xs:annotation>
                                    <xs:complexType>
                                       <xs:sequence>
                                          <xs:element name="nameOrganisation" type="din91379:datatypeC">
                                             <xs:annotation>
                                                <xs:documentation>Hier ist der Name der anzeigenden Organisation (Einrichtung oder Bestattungsunternehmen) zu übermitteln.</xs:documentation>
                                             </xs:annotation>
                                          </xs:element>
                                          <xs:element name="nameNatuerlichePerson"
                                                      minOccurs="0"
                                                      type="xpersonenstand:PersonName">
                                             <xs:annotation>
                                                <xs:documentation>Hier kann der Name der natürlichen Person übermittelt, die für eine Einrichtung oder ein Bestattungsunternehmen die Sterbefallanzeige vornimmt.</xs:documentation>
                                             </xs:annotation>
                                          </xs:element>
                                       </xs:sequence>
                                    </xs:complexType>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="portal2StA.Sterbefall.084020">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 28 Nummer 2 PStG i.V.m. § 30 (1) PStG sowie § 3a (2) VwVfG i.V.m. § 63 PStV</rechtsgrundlage>
            <title>Anzeige des Sterbefalls durch eine Einrichtung</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht kann eine Einrichtung, in der Sterbefälle stattfinden, ihrer gesetzlichen Anzeigepflicht nachkommen. Zur besseren Zuordenbarkeit der Anzeige der Einrichtung, der Anzeige des Bestatters sowie der Todesbescheinigung kann die vom leichenschauenden Arzt ausgestellte leichenID in dem Element leichenID übermittelt werden, die in den zugehörigen Nachrichten 084040 sowie 084021 identisch übermittelt wird.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2GXP">
               <xs:sequence>
                  <xs:element name="sterbefall" type="xpersonenstand:Portal2StA.Sterbefall">
                     <xs:annotation>
                        <xs:documentation>Hier werden von der Einrichtung die Angaben zum Sterbefall (Ort, Datum) übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="verstorbener"
                              type="xpersonenstand:Portal2StA.Sterbefall.Verstorbener.Einrichtung">
                     <xs:annotation>
                        <xs:documentation>In diesem Element übermittelt die Einrichtung Informationen zu dem Verstorbenen im Rahmen der Anzeige des Sterbefalls, die sie aufgrund der Identifikation mit der Gesundheitskarte gesichert machen kann. Namen und Geburtstag des Verstorbenen werden als Daten zur Zuordnung der Nachrichten 084020, 084021 und ggf. 084040 verwendet, falls die Leichen-ID nicht zur Identifikation verwendet werden kann.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzeigender">
                     <xs:annotation>
                        <xs:documentation>Hier werden die Angaben zum Anzeigenden übermittelt, um dem Standesamt eine Möglichkeit zur Rücksprache bei Fragen zu geben.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Portal2StA.Anzeigender">
                              <xs:sequence>
                                 <xs:element name="namen">
                                    <xs:annotation>
                                       <xs:documentation>Hier werden die Namen des Anzeigenden mitgeteilt.</xs:documentation>
                                    </xs:annotation>
                                    <xs:complexType>
                                       <xs:sequence>
                                          <xs:element name="nameOrganisation" type="din91379:datatypeC">
                                             <xs:annotation>
                                                <xs:documentation>Hier ist der Name der anzeigenden Organisation (Einrichtung oder Bestattungsunternehmen) zu übermitteln.</xs:documentation>
                                             </xs:annotation>
                                          </xs:element>
                                          <xs:element name="nameNatuerlichePerson"
                                                      minOccurs="0"
                                                      type="xpersonenstand:PersonName">
                                             <xs:annotation>
                                                <xs:documentation>Hier kann der Name der natürlichen Person übermittelt, die für eine Einrichtung oder ein Bestattungsunternehmen die Sterbefallanzeige vornimmt.</xs:documentation>
                                             </xs:annotation>
                                          </xs:element>
                                       </xs:sequence>
                                    </xs:complexType>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="leichenID" minOccurs="0" type="xs:string">
                     <xs:annotation>
                        <xs:documentation>Hier ist die eindeutige Leichen-ID zu übermitteln, falls sie vorhanden ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="portal2StA.Sterbefall.084021">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 28 Nummer 1 PStG i.V.m. § 29 PStG sowie § 3a (2) VwVfG i.V.m. § 63 PStV</rechtsgrundlage>
            <title>Anzeige des Sterbefalls durch den Bestatter</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht können Bestatter die Daten zu einem Sterbefall übermitteln, die die Einrichtung nicht gesichert liefern kann. Zur besseren Zuordenbarkeit der Anzeige der Einrichtung, der Anzeige des Bestatters sowie der Todesbescheinigung kann die vom leichenschauenden Arzt ausgestellte leichenID in dem Element leichenID übermittelt werden, die in den zugehörigen Nachrichten 084040 sowie 084020 identisch übermittelt wird.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2GXP">
               <xs:sequence>
                  <xs:element name="sterbefall"
                              minOccurs="0"
                              type="xpersonenstand:Portal2StA.Sterbefall">
                     <xs:annotation>
                        <xs:documentation>Hier können vom Bestatter die Angaben zum Sterbefall (Ort, Datum) übermittelt werden. Diese Angaben dienen der Plausibilisierung, die Zuordnung zur Nachricht der Einrichtung (084020) und zur eTodesbescheinigung (084040) erfolgt anhand der leichenID.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="verstorbener"
                              type="xpersonenstand:Portal2StA.Sterbefall.Verstorbener.Bestatter">
                     <xs:annotation>
                        <xs:documentation>In diesem Feld übermittelt der Bestatter die Angaben zum Verstorbenen, die die Einrichtung nicht gesichert liefern kann. Namen und Geburtstag des Verstorbenen werden als Daten zur Zuordnung der Nachrichten 084020, 084021 und ggf. 084040 verwendet, falls die Leichen-ID nicht zur Identifikation verwendet werden kann.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="partnerVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Portal2StA.Sterbefall.VerstorbenerPartner.Bestatter">
                     <xs:annotation>
                        <xs:documentation>Hier werden Angaben zum Partner des Verstorbenen übermittelt, falls es einen gibt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzeigender">
                     <xs:annotation>
                        <xs:documentation>Hier werden die Angaben zum Anzeigenden übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Portal2StA.Anzeigender">
                              <xs:sequence>
                                 <xs:element name="namen">
                                    <xs:annotation>
                                       <xs:documentation>Hier werden die Namen des Anzeigenden mitgeteilt.</xs:documentation>
                                    </xs:annotation>
                                    <xs:complexType>
                                       <xs:sequence>
                                          <xs:element name="nameOrganisation" type="din91379:datatypeC">
                                             <xs:annotation>
                                                <xs:documentation>Hier ist der Name der anzeigenden Organisation (Einrichtung oder Bestattungsunternehmen) zu übermitteln.</xs:documentation>
                                             </xs:annotation>
                                          </xs:element>
                                          <xs:element name="nameNatuerlichePerson"
                                                      minOccurs="0"
                                                      type="xpersonenstand:PersonName">
                                             <xs:annotation>
                                                <xs:documentation>Hier kann der Name der natürlichen Person übermittelt, die für eine Einrichtung oder ein Bestattungsunternehmen die Sterbefallanzeige vornimmt.</xs:documentation>
                                             </xs:annotation>
                                          </xs:element>
                                       </xs:sequence>
                                    </xs:complexType>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="auskunftsgeber" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Falls es einen Auskunftsgeber gibt und dieser nicht Partner oder Kind des Verstorbenen ist, werden dessen Angaben hier übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="vorname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Falls bekannt, werden hier die Vornamen des Auskunftsgebers übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="familienname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen eine Unterscheidung von Vor- und Familiennamen nicht möglich ist oder ein Vorname zurecht nicht existiert, wird der Name des Auskunftsgebers vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Sofern vorhanden, ist hier der Geburtsname mitzuteilen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="anschrift"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Anschrift"/>
                           <xs:element name="kontaktdaten"
                                       maxOccurs="unbounded"
                                       type="bn-uq-g2g:KommunikationType"/>
                           <xs:element name="verhaeltnisVerstorbener"
                                       minOccurs="0"
                                       type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Angaben über das verwandtschaftliche Verhältnis des Auskunftgebers zum Verstorbenen (z.B. Sohn, Ehefrau, etc.).</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="anzahlKinderVolljaehrig"
                              minOccurs="0"
                              type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, wird hier die Anzahl der volljährigen Kinder übermittelt. Ist bekannt, dass der Verstorbene keine volljährigen Kinder hatte, wird "0" übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="volljaehrigeKinder" minOccurs="0" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, werden hier Angaben zu den volljährigen Kindern des Verstorbenen übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="familienname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen eine Unterscheidung von Vor- und Familiennamen nicht möglich ist oder ein Vorname zurecht nicht existiert, wird der Name des Kindes vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Sofern vorhanden, ist hier der Geburtsname mitzuteilen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vornamen" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Falls bekannt, werden hier die Vornamen des Kindes übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="anschrift"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Anschrift">
                              <xs:annotation>
                                 <xs:documentation>Hier wird die Anschrift des Minderjährigen übermittelt, falls bekannt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="istAuskunftsgeber"
                                       minOccurs="0"
                                       fixed="true"
                                       type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Falls die Person auch Auskunftsgeber ist, wird hier true übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="anzahlKinderMinderjaehrig"
                              minOccurs="0"
                              type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, wird hier die Anzahl der minderjährigen Kinder übermittelt. Ist bekannt, dass der Verstorbene keine minderjährigen Kinder hatte, wird "0" übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="minderjaehrigeKinder" minOccurs="0" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, werden hier Angaben zu den minderjährigen Kindern des Verstorbenen übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="familienname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen eine Unterscheidung von Vor- und Familiennamen nicht möglich ist oder ein Vorname zurecht nicht existiert, wird der Name des minderjährigen Kindes vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vornamen" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Falls bekannt, werden hier die Vornamen des minderjährigen Kindes übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtstag" minOccurs="0" type="xida:Tagesdatum">
                              <xs:annotation>
                                 <xs:documentation>Es wird kein Geburtsdatum übermittelt, wenn das Geburtsdatum nur teilbekannt ist. Teilbekannt ist ein Geburtsdatum bspw. wenn zwar das Jahr und der Monat der Geburt bekannt sind, der Tag der Geburt aber unbekannt ist.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsort"
                                       minOccurs="0"
                                       type="xpersonenstand:Anz2StA.Ereignisort"/>
                           <xs:element name="geburtseintrag"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Registereintrag">
                              <xs:annotation>
                                 <xs:documentation>Hier werden die Angaben zum Geburtseintrag eines minderjährigen Kindes des Verstorbenen übermittelt, falls vorhanden. Angaben zu Registereinträgen werden nur für inländische Einträge übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="anschrift"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Anschrift">
                              <xs:annotation>
                                 <xs:documentation>Hier wird die Anschrift des Minderjährigen übermittelt, falls bekannt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vollwaise" minOccurs="0" fixed="true" type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Diese Angabe wird übermittelt, um anzuzeigen, dass der Minderjährige durch den Sterbefall zum Vollwaise wurde.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="istAuskunftsgeber"
                                       minOccurs="0"
                                       fixed="true"
                                       type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Falls die Person auch Auskunftsgeber ist, wird hier true übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="artDerBestattung"
                              minOccurs="0"
                              type="xpersonenstand:Code.Bestattungsart">
                     <xs:annotation>
                        <xs:documentation>Hier wird die Art der Bestattung übermittelt, falls diese bekannt ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zahlDerUrkunden"
                              minOccurs="0"
                              type="xpersonenstand:Urkundenanforderung.ArtDerUrkunde.Erweitert">
                     <xs:annotation>
                        <xs:documentation>Falls vom Standesamt nach der Beurkundung Sterbeurkunden zum Sterbefall gewünscht werden, wird dies hier übermittelt. Urkunden, die für die Bestattung benötigt werden, sind mitzuzählen, auch wenn sie nach Landesrecht kostenfrei oder kostenreduziert sind.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="abholungImStandesamt"
                              minOccurs="0"
                              fixed="true"
                              type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Hier wird "true" übermittelt, wenn die Urkunden im Standesamt abgeholt werden. Falls dieses Feld nicht übermittelt wird, aber das Feld "zahlDerUrkunden" übermittelt wird, so müssen die Urkunden postalisch zugestellt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="letzteEheVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Partnerschaft.Verstorbener.Familienbuch">
                     <xs:annotation>
                        <xs:documentation>Wenn der Verstorbene zum Zeitpunkt des Todes verheiratet, verwitwet oder geschieden war, werden hier die Angaben zur letzten Eheschließung übermittelt. Angaben zum Registereintrag werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="letzteLpVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Wenn der Verstorbene zum Zeitpunkt des Todes in eingetragener Lebenspartnerschaft lebte oder die Lebenspartnerschaft aufgelöst war, werden hier die Angaben zur Begründung der letzten Lebenspartnerschaft gemacht. Angaben zum Registereintrag werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aufloesungEheVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Aufloesung.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier können Angaben zur Auflösung der letzten Ehe des Verstorbenen übermittelt werden. Angaben zu Registereinträgen werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aufloesungLpVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Aufloesung.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier können Angaben zur Auflösung der letzten Lebenspartnerschaft des Verstorbenen übermittelt werden. Angaben zu Registereinträgen werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="bescheinigungBeiZurueckstellung"
                              minOccurs="0"
                              fixed="true"
                              type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Diese Angabe wird übermittelt, falls vom Bestatter eine Bescheinigung bei der Zurückstellung der Beurkundung gewünscht wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="leichenID" minOccurs="0" type="xs:string">
                     <xs:annotation>
                        <xs:documentation>Hier ist die eindeutige Leichen-ID zu übermitteln, falls sie vorhanden ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="portal2StA.Sterbefall.084025">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 36 PStG</rechtsgrundlage>
            <title>Antrag auf Nachbeurkundung eines Sterbefalls</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht können berechtigte Antragsteller die Nachbeurkundung eines Sterbefalls im Ausland beim zuständigen deutschen Standesamt (ausgenommen Standesamt I in Berlin) digital beantragen.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2GXP">
               <xs:sequence>
                  <xs:element name="antragsteller"
                              type="xpersonenstand:Urkundenanforderung.Antragsteller.Papier">
                     <xs:annotation>
                        <xs:documentation>Hier werden die Angaben zum Antragsteller übermittelt, um dem Standesamt eine Möglichkeit zur Rücksprache bei Fragen zu geben.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="sterbefall" type="xpersonenstand:Portal2StA.Sterbefall">
                     <xs:annotation>
                        <xs:documentation>Hier werden Angaben zum Sterbefall (Ort, Datum) übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="verstorbener"
                              type="xpersonenstand:Portal2StA.Sterbefall.Verstorbener.Nachbeurkundung">
                     <xs:annotation>
                        <xs:documentation>Hier werden Informationen zum Verstorbenen übermittelt, dessen Sterbefall nachbeurkundet werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="partnerVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Portal2StA.Sterbefall.VerstorbenerPartner.Bestatter">
                     <xs:annotation>
                        <xs:documentation>Hier werden Angaben zum Partner des Verstorbenen übermittelt, falls es einen gibt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzahlKinderVolljaehrig"
                              minOccurs="0"
                              type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, wird hier die Anzahl der volljährigen Kinder übermittelt. Ist bekannt, dass der Verstorbene keine volljährigen Kinder hatte, wird "0" übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="volljaehrigeKinder" minOccurs="0" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, werden hier Angaben zu den volljährigen Kindern des Verstorbenen übermittelt, die zum Zeitpunkt des Todes noch lebten.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="familienname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen eine Unterscheidung von Vor- und Familiennamen nicht möglich ist oder ein Vorname zurecht nicht existiert, wird der Name des Kindes vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Sofern vorhanden, ist hier der Geburtsname mitzuteilen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vornamen" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Falls bekannt, werden hier die Vornamen des Kindes übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="anschrift"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Anschrift">
                              <xs:annotation>
                                 <xs:documentation>Hier wird die Anschrift des Minderjährigen übermittelt, falls bekannt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="istAuskunftsgeber"
                                       minOccurs="0"
                                       fixed="true"
                                       type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Falls die Person auch Auskunftsgeber ist, wird hier true übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="anzahlKinderMinderjaehrig"
                              minOccurs="0"
                              type="xs:nonNegativeInteger">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, wird hier die Anzahl der minderjährigen Kinder übermittelt. Ist bekannt, dass der Verstorbene keine minderjährigen Kinder hatte, wird "0" übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="minderjaehrigeKinder" minOccurs="0" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Falls bekannt, werden hier Angaben zu minderjährigen Kindern des Verstorbenen übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="familienname" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Hier wird der Familienname übermittelt. In den Fällen in denen eine Unterscheidung von Vor- und Familiennamen nicht möglich ist oder ein Vorname zurecht nicht existiert, wird der Name des minderjährigen Kindes vollständig in diesem Element übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vornamen" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Falls bekannt, werden hier die Vornamen des minderjährigen Kindes übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtstag" minOccurs="0" type="xida:Tagesdatum">
                              <xs:annotation>
                                 <xs:documentation>Es wird kein Geburtsdatum übermittelt, wenn das Geburtsdatum nur teilbekannt ist. Teilbekannt ist ein Geburtsdatum bspw. wenn zwar das Jahr und der Monat der Geburt bekannt sind, der Tag der Geburt aber unbekannt ist.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="geburtsort"
                                       minOccurs="0"
                                       type="xpersonenstand:Anz2StA.Ereignisort"/>
                           <xs:element name="geburtseintrag"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Registereintrag">
                              <xs:annotation>
                                 <xs:documentation>Hier werden die Angaben zum Geburtseintrag eines minderjährigen Kindes des Verstorbenen übermittelt, falls vorhanden. Angaben zu Registereinträgen werden nur für inländische Einträge übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="anschrift"
                                       minOccurs="0"
                                       type="xpersonenstand:Portal2StA.Anschrift">
                              <xs:annotation>
                                 <xs:documentation>Hier wird die Anschrift des Minderjährigen übermittelt, falls bekannt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vollwaise" minOccurs="0" fixed="true" type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Diese Angabe wird übermittelt, um anzuzeigen, dass der Minderjährige durch den Sterbefall zum Vollwaise wurde.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="istAuskunftsgeber"
                                       minOccurs="0"
                                       fixed="true"
                                       type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Falls die Person auch Auskunftsgeber ist, wird hier true übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="letzteEheVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Partnerschaft.Verstorbener.Familienbuch">
                     <xs:annotation>
                        <xs:documentation>Wenn der Verstorbene zum Zeitpunkt des Todes verheiratet, verwitwet oder geschieden war, werden hier die Angaben zur letzten Eheschließung übermittelt. Angaben zum Registereintrag werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="letzteLpVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Wenn der Verstorbene zum Zeitpunkt des Todes in eingetragener Lebenspartnerschaft lebte oder die Lebenspartnerschaft aufgelöst war, werden hier die Angaben zur Begründung der letzten Lebenspartnerschaft gemacht. Angaben zum Registereintrag werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aufloesungEheVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Aufloesung.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier können Angaben zur Auflösung der letzten Ehe des Verstorbenen übermittelt werden. Angaben zu Registereinträgen werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aufloesungLpVerstorbener"
                              minOccurs="0"
                              type="xpersonenstand:Anz2StA.Aufloesung.Partnerschaft.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier können Angaben zur Auflösung der letzten Lebenspartnerschaft des Verstorbenen übermittelt werden. Angaben zu Registereinträgen werden nur für inländische Einträge übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="urkundenbestellung"
                              type="xpersonenstand:Urkundenanforderung.ArtDerUrkunde.Erweitert">
                     <xs:annotation>
                        <xs:documentation>Dieses Element enthält Angaben zu den bestellten Urkunden im Rahmen der Nachbeurkundung eines Sterbefalls.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zahlungsinformation"
                              minOccurs="0"
                              type="xpersonenstand:Portal2StA.Zahlungsinformation">
                     <xs:annotation>
                        <xs:documentation>Falls die Zahlung durch das Eingabeverfahren abgewickelt wurde, können hier Informationen dazu übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="sonstigeAngaben" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Hier können sonstige Angaben, Erläuterung und Mitteilungen zum Antrag übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="portal2StA.Sterbefall.084030">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 62 PStG i.V.m. § 55 PStG</rechtsgrundlage>
            <title>Anforderung von Urkunden aus dem Sterberegister</title>
         </xs:appinfo>
         <xs:documentation>Diese Nachricht erlaubt die Anforderung von Urkunden aus dem Sterberegister. Diese Nachricht erlaubt die Übermittlung von Anhängen. Die Einzelheiten können dem anhaengeUrkundenbestellung entnommen werden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2G">
               <xs:sequence>
                  <xs:element name="verwendungszweck"
                              minOccurs="0"
                              type="xpersonenstand:Code.VerwendungszweckSterbeurkunde">
                     <xs:annotation>
                        <xs:documentation>Hier kann optional der Verwendungszweck angegeben werden, für den die Urkunden bestellt werden. Damit kann das Standesamt prüfen, ob die Bestellungen (insbesondere von Registerausdrucken mit Hinweisen) zum Verwendungszweck passen, und gegebenenfalls fälschliche Ausstellungen verhindern.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="beurkundeterSterbefall">
                     <xs:annotation>
                        <xs:documentation>Hier werden Daten zur beurkundeten Person übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Urkundenanforderung.BeurkundetesEreignis">
                              <xs:sequence>
                                 <xs:element name="sterbedatum" minOccurs="0" type="xida:Tagesdatum">
                                    <xs:annotation>
                                       <xs:documentation>Hier wird das Sterbedatum übermittelt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                                 <xs:element name="sterbeort" type="din91379:datatypeC">
                                    <xs:annotation>
                                       <xs:documentation>Hier wird das Sterbeort übermittelt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="antragsteller"
                              type="xpersonenstand:Urkundenanforderung.Antragsteller.Papier">
                     <xs:annotation>
                        <xs:documentation>Hier werden Daten zum Antragsteller übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angeforderteUrkunden" type="xpersonenstand:Urkundenanforderung.S">
                     <xs:annotation>
                        <xs:documentation>Hier werden Angaben zur Art und Anzahl der auszustellenden Urkunden übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="modalitaeten"
                              minOccurs="0"
                              type="xpersonenstand:Urkundenanforderung.Modalitaeten">
                     <xs:annotation>
                        <xs:documentation>Dieser Feld dient zur Übermittlung der Modalitäten einer Urkundenanforderung, namentlich ob die Urkunden im Standesamt abgeholt werden und wie sie bezahlt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="portal2StA.Sterbefall.084032">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 55 PStG</rechtsgrundlage>
            <title>Anforderung von elektronischen Personenstandsbescheinigungen aus dem Sterberegister</title>
         </xs:appinfo>
         <xs:documentation>Diese Nachricht erlaubt die Anforderung von elektronischen Personenstandsnachweisen aus dem Sterberegister.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2G">
               <xs:sequence>
                  <xs:element name="antragsteller"
                              type="xpersonenstand:Urkundenanforderung.Antragsteller.Elektronisch">
                     <xs:annotation>
                        <xs:documentation>Hier werden Daten zum Antragsteller übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="verwendungszweck" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Hier kann optional der Verwendungszweck angegeben werden, für den die Bescheinigungen bestellt werden. Damit kann das Standesamt prüfen, ob die Bestellungen zum Verwendungszweck passen, und gegebenenfalls fälschliche Ausstellungen verhindern.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="beurkundeterSterbefall">
                     <xs:annotation>
                        <xs:documentation>Hier werden Daten zum Sterbefall übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Urkundenanforderung.BeurkundetesEreignis">
                              <xs:sequence>
                                 <xs:element name="sterbedatum" minOccurs="0" type="xida:Tagesdatum">
                                    <xs:annotation>
                                       <xs:documentation>Hier wird das Sterbedatum übermittelt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                                 <xs:element name="sterbeort" type="din91379:datatypeC">
                                    <xs:annotation>
                                       <xs:documentation>Hier wird das Sterbeort übermittelt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="mitNormal" minOccurs="0" fixed="true" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Dieses Feld ist zu übermitteln, falls eine normale (kostenpflichtige) Urkunde ausgeliefert werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="mitKostenfrei"
                              minOccurs="0"
                              fixed="true"
                              type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Dieses Feld ist zu übermitteln, falls eine kostenfreie Urkunde ausgeliefert werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zahlungsinformationen"
                              minOccurs="0"
                              type="xpersonenstand:Portal2StA.Zahlungsinformation">
                     <xs:annotation>
                        <xs:documentation>Falls die Zahlung durch das Eingabeverfahren abgewickelt wurde, können hier Informationen dazu übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zuordnung" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Falls eine solche für den Bestellprozess und/oder den Auslieferungsprozess benötigt wird, kann hier eine Zuordnung (beispielweise eine Referenz auf das Benutzerkonto des Bestellers oder eine UUID) übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="stA2portal.Sterbefall.084033">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 55 PStG</rechtsgrundlage>
            <title>Lieferung von elektronischen Personenstandsbescheinigungen aus dem Sterberegister</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht können elektronische Personenstandsnachweise aus dem Sterberegister ausgeliefert werden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2G">
               <xs:sequence>
                  <xs:element name="antragsteller"
                              type="xpersonenstand:Urkundenanforderung.Antragsteller.Elektronisch">
                     <xs:annotation>
                        <xs:documentation>Hier werden Daten zum Antragsteller übermittelt. Die Angaben müssen den Angaben aus der Anforderungsnachricht entsprechen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zuordnung" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Falls eine Zuordnung (beispielweise eine Kontoreferenz oder eine UUID) in der Ausgangsnachricht übermittelt wurde, wird sie hier zurückgespiegelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="portal2StA.Sterbefall.084040">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>noch zu schaffen</rechtsgrundlage>
            <title>Mitteilung eines Arztes über eine Leichenschau (elektronische Todesbescheinigung)</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht kann ein Arzt die Daten zu einer Leichenschau mitteilen. Zur besseren Zuordenbarkeit der sich anschließenden Mitteilung des Standesamtes an eine Gesundheitsbehörde zur Mitteilung des Arztes an die Gesundheitsbehörde muss eine eindeutige Leichen-ID im Element leichenID übermittelt werden, die in der zugehörigen Nachricht 104010 identisch übermittelt wird.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2GXP">
               <xs:sequence>
                  <xs:element name="verstorbener"
                              type="xpersonenstand:Todesbescheinigung.Verstorbener">
                     <xs:annotation>
                        <xs:documentation>Hier sind Angaben zum Verstorbenen zu übermitteln. Namen und Geburtstag des Verstorbenen werden als Daten zur Zuordnung der Nachrichten 084020, 084021 und ggf. 084040 verwendet, falls die Leichen-ID nicht zur Identifikation verwendet werden kann.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="sterbefall" type="xpersonenstand:Todesbescheinigung.Sterbefall">
                     <xs:annotation>
                        <xs:documentation>Hier sind Angaben zum Sterbefall zu übermitteln.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabenLeichenschau"
                              type="xpersonenstand:Todesbescheinigung.Leichenschau">
                     <xs:annotation>
                        <xs:documentation>Hier sind die Angaben zur Leichenschau und zum durchführenden Arzt zu übermitteln.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="leichenID" type="xs:string">
                     <xs:annotation>
                        <xs:documentation>Hier ist die eindeutige Leichen-ID zu übermitteln.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
</xs:schema>
