<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xpersonenstand="http://xpsw.domap.de/xpsw2611"
           xmlns:din91379="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
           targetNamespace="http://xpsw.domap.de/xpsw2611"
           version="26.11"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
   <xs:annotation>
      <xs:appinfo>
         <standard>
            <nameLang>XPersonenstand</nameLang>
            <nameKurz>XPersonenstand</nameKurz>
            <nameTechnisch>xinneres.xpersonenstand</nameTechnisch>
            <kennung>urn:xoev-de:kosit:standard:xinneres.xpersonenstand</kennung>
            <beschreibung>Projektziel ist die elektronische Kommunikation der Standesämter untereinander und mit anderen Behörden und Institutionen, welche Daten von den Standesämtern erhalten oder an Standesämter senden. Der Nutzen des Projektes besteht in der Kostenreduktion und einer Verbesserung der Qualität der Personenstandsdaten sowie einer Verbesserung der Interoperabilität in der Kommunikation der Standesämter untereinander und zu weiteren Kommunikationspartnern.
</beschreibung>
         </standard>
         <versionStandard>
            <version>26.11</version>
            <versionXOEVProfil>3.0.3</versionXOEVProfil>
            <versionXOEVHandbuch>2.4</versionXOEVHandbuch>
            <versionXGenerator>3.0.1</versionXGenerator>
            <versionModellierungswerkzeug>19.0 SP4</versionModellierungswerkzeug>
            <nameModellierungswerkzeug>MagicDraw</nameModellierungswerkzeug>
         </versionStandard>
      </xs:appinfo>
   </xs:annotation>
   <xs:include schemaLocation="xpersonenstand-nachrichten-portale.xsd"/>
   <xs:import schemaLocation="https://xoev.de/schemata/din/91379/2022-08/din-norm-91379-datatypes.xsd"
              namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"/>
   <xs:element name="eU2StA.Geburt.081023">
      <xs:annotation>
         <xs:appinfo>
            <autor>Portal (dbs)</autor>
            <leser>Standesamt (psw)</leser>
            <rechtsgrundlage>§ 55 PStG</rechtsgrundlage>
            <title>Lieferung von elektronischen Nachweisen aus dem EU-Ausland an das Geburtenregister</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht können elektronische Nachweise aus dem EU-Ausland an das Standesamt geliefert werden. Bei Mehrlingsgeburten ist für jedes Kind eine eigene Nachricht zu versenden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xpersonenstand:Nachricht.G2G">
               <xs:sequence>
                  <xs:element name="geburtsangaben">
                     <xs:annotation>
                        <xs:documentation>Dieses Element enthält die Angaben zur Geburt. Die Angaben werden nur zum Zweck der Zuordnung zur Anzeige der Einrichtung übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:complexContent>
                           <xs:extension base="xpersonenstand:Anz2StA.Geburt.AngabenEreignis">
                              <xs:sequence>
                                 <xs:element name="uhrzeit" type="xpersonenstand:UhrzeitPersonenstandswesen">
                                    <xs:annotation>
                                       <xs:documentation>Dieses Element enthält die Uhrzeit der Geburt.</xs:documentation>
                                    </xs:annotation>
                                 </xs:element>
                              </xs:sequence>
                           </xs:extension>
                        </xs:complexContent>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="mutter" type="xpersonenstand:Anz2StA.Geburt.Elternteil.Basis">
                     <xs:annotation>
                        <xs:documentation>Dieses Element enthält den Namen der Mutter. Dieser wird zum Zweck der Zuordnung zur Geburtsanzeige übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zuordnungGeburtsanzeige"
                              minOccurs="0"
                              type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Hier kann eine menschenlesbare Zeichenkette übermittelt werden, die eine eindeutige Zuordnung zur Datenlieferung der Eltern (081021) und zur Anzeige der Einrichtung (081020) ermöglicht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anhang"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xpersonenstand:AnhangInformation">
                     <xs:annotation>
                        <xs:documentation>Hier können Anhänge gemäß des Kapitels zu Anhängen an die Fachnachricht übermittelt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ausstellendeBehoerde"
                              minOccurs="0"
                              type="xpersonenstand:Behoerdenbezeichnung.Flexibel">
                     <xs:annotation>
                        <xs:documentation>Hier kann die Behörde übermittelt werden, die den Nachweis ausgestellt hat.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
</xs:schema>
